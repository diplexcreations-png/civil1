# OPENROUTER_API_KEY: Required for CiviCore AI chat and explain endpoints.
# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=""

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID (format G-XXXXXXXXXX)
# This is injected at build time — set it in your Vercel/Netlify dashboard
# under the VITE_GA_MEASUREMENT_ID environment variable.
# Create at https://analytics.google.com/ → Admin → Data Streams → Web
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
